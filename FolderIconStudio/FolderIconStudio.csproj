<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FolderIconStudio</AssemblyName>
    <RootNamespace>FolderIconStudio</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Folder Icon Studio</Company>
    <Product>Folder Icon Studio</Product>
    <Description>Windows 11 folder icon changer</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\StarterIcons\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets\StarterIcons" />
  </ItemGroup>

  <Target Name="GenerateStarterIcons" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\StarterIconGenerator\StarterIconGenerator.csproj&quot; -- &quot;$(MSBuildThisFileDirectory)Assets\StarterIcons&quot;" />
  </Target>

</Project>
