<Window x:Class="FolderIconStudio.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#E61E1E1E" CornerRadius="8" Margin="8" Padding="24"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <TextBlock Text="Icon library folder" Opacity="0.8" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LibraryPathBox" Padding="8,6" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="12,6"
                        Click="BrowseLibrary_Click"/>
            </Grid>

            <TextBlock Text="Theme" Opacity="0.8" Margin="0,0,0,6"/>
            <ComboBox x:Name="ThemeCombo" Margin="0,0,0,16" Padding="8,6">
                <ComboBoxItem Content="Follow system"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>

            <CheckBox x:Name="ContextMenuToggle" Content="Show &quot;Change Icon…&quot; in folder context menu"
                      Margin="0,0,0,8"/>
            <TextBlock Text="Appears under &quot;Show more options&quot; in File Explorer on Windows 11."
                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Save" Padding="16,8" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
