<Window x:Class="FolderIconStudio.Views.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Folder Icon Studio"
        Height="320" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#E61E1E1E" CornerRadius="8" Margin="8" Padding="28"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Welcome!" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.85" LineHeight="22" Margin="0,0,0,20">
                Folder Icon Studio is ready. Your icon library will be created at
                Pictures\Folder Icons with 26 starter folder icons.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Opacity="0.85" LineHeight="22" Margin="0,0,0,24">
                Would you like to add &quot;Change Icon…&quot; to the folder right-click menu?
                (Windows 11: right-click → Show more options)
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Not now" Padding="16,8" Margin="0,0,8,0" Click="No_Click"/>
                <Button Content="Yes, add it" Padding="16,8" IsDefault="True" Click="Yes_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
