<Window x:Class="FolderIconStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderIconStudio.ViewModels"
        Title="Folder Icon Studio"
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="#30FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="#CC1A1A1A" CornerRadius="10" Margin="10"
            BorderBrush="#35FFFFFF" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Folder Icon Studio" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TargetFolderDisplay}" Opacity="0.7" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="⚙" FontSize="18" Width="40" Height="40"
                        ToolTip="Settings" Click="Settings_Click"
                        Background="Transparent" BorderThickness="0"/>
            </Grid>

            <!-- Search -->
            <TextBox Grid.Row="1" Margin="0,0,0,12" Padding="10,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search icons…">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Search icons…" Foreground="#80FFFFFF" Margin="10,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Missing icon warning -->
            <Border Grid.Row="2" Margin="0,0,0,8" Padding="12,8" CornerRadius="6"
                    Background="#40FF9800" BorderBrush="#80FF9800" BorderThickness="1"
                    Visibility="{Binding IconMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock TextWrapping="Wrap">
                    The icon file for this folder is missing.
                    <Hyperlink Command="{Binding RestoreCommand}">Restore default</Hyperlink>
                </TextBlock>
            </Border>

            <!-- Recently used -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8"
                        Visibility="{Binding HasRecentIcons, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="Recently used" FontWeight="SemiBold" Opacity="0.8" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding RecentIcons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource IconTile}" Width="96" Height="104"
                                    MouseLeftButtonUp="IconTile_Click" Tag="{Binding}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding Preview}" Width="64" Height="64" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="88"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Icon grid -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredIcons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource IconTile}"
                                    MouseLeftButtonUp="IconTile_Click" Tag="{Binding}">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding Preview}" Width="80" Height="80" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                    </StackPanel>
                                    <Button Content="★" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="4" Padding="4,0" FontSize="12"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{Binding IsFavorite, Converter={x:Static vm:FavoriteColorConverter.Instance}}"
                                            Click="Favorite_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.75"
                           TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="Pick folder…"
                            Command="{Binding PickFolderCommand}"/>
                    <Button Style="{StaticResource ActionButton}" Content="Browse file…"
                            Command="{Binding BrowseFileCommand}"/>
                    <Button Style="{StaticResource ActionButton}" Content="Open icon folder"
                            Command="{Binding OpenLibraryCommand}"/>
                    <Button Style="{StaticResource ActionButton}" Content="Restore default"
                            Command="{Binding RestoreCommand}"/>
                    <Button Content="Save" Padding="18,8" FontWeight="SemiBold"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource SystemAccentColorBrush}"
                            Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
